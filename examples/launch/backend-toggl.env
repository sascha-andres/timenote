# Environment for backend-toggl.service. Keep the file mode 600.
BACKEND_TOGGL_TOKEN=change-me
# Optional. If not set, backend-toggl uses the timenote keyring entry.
#TOGGL_TOKEN=
# Optional. OpenTelemetry tracing, off if OTEL_TRACES_EXPORTER is not set.
#OTEL_TRACES_EXPORTER=otlp
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_SERVICE_NAME=backend-toggl
